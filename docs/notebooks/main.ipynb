    "def plot_poverty_share_bars(data_dir: str, output_path: str = None):\n",
    "    \"\"\"\n",
    "    Create stacked bar charts showing the share of global poor in FCS vs non-FCS economies\n",
    "    across different poverty lines and years.\n",
    "    \"\"\"\n",
    "    import os\n",
    "    import pandas as pd\n",
    "    import matplotlib.pyplot as plt\n",
    "    import numpy as np\n",
    "\n",
    "    # Read the data\n",
    "    data_path = os.path.join(data_dir, 'poverty_data.csv')\n",
    "    df = pd.read_csv(data_path)\n",
    "\n",
    "    # Create FCV grouping using fcvFY25 variable\n",
    "    # Convert 'Yes'/'No' to 1/0\n",
    "    df['is_fcv'] = (df['fcvFY25'] == 'Yes').astype(int)\n",
    "\n",
    "    # Ensure required columns exist\n",
    "    required_cols = ['pop', 'poorpop']\n",
    "    for col in required_cols:\n",
    "        if col not in df.columns:\n",
    "            raise KeyError(f\"Missing required column: {col}\")\n",
    "\n",
    "    key_years = [2000, 2015, 2025, 2030, 2050]\n",
    "    poverty_lines = [3.0, 4.2, 8.3]\n",
    "\n",
    "    plot_data = []\n",
    "    for year in key_years:\n",
    "        for pline in poverty_lines:\n",
    "            year_pline_data = df[(df['year'] == year) & (df['povertyline'] == pline)]\n",
    "\n",
    "            if year_pline_data.empty:\n",
    "                continue\n",
    "\n",
    "            # Compute total poor population globally\n",
    "            total_poor_global = year_pline_data['poorpop'].sum()\n",
    "\n",
    "            # Compute total poor population for FCS and non-FCS\n",
    "            total_poor_fcs = year_pline_data[year_pline_data['is_fcv'] == 1]['poorpop'].sum()\n",
    "            total_poor_non_fcs = year_pline_data[year_pline_data['is_fcv'] == 0]['poorpop'].sum()\n",
    "\n",
    "            # Avoid division by zero\n",
    "            fcs_share = (total_poor_fcs / total_poor_global * 100) if total_poor_global > 0 else np.nan\n",
    "            non_fcs_share = (total_poor_non_fcs / total_poor_global * 100) if total_poor_global > 0 else np.nan\n",
    "\n",
    "            plot_data.append({\n",
    "                'year': year,\n",
    "                'povertyline': pline,\n",
    "                'non_fcs_share': non_fcs_share,\n",
    "                'fcs_share': fcs_share\n",
    "            })\n",
    "\n",
    "    plot_df = pd.DataFrame(plot_data)\n",
    "\n",
    "    # If no data, exit early\n",
    "    if plot_df.empty:\n",
    "        print(\"No valid data available for plotting. Exiting.\")\n",
    "        return\n",
    "\n",
    "    # Plot setup\n",
    "    plt.style.use('default')\n",
    "    fig, ax = plt.subplots(figsize=(16, 9))\n",
    "    ax.set_facecolor('#F8F9FA')\n",
    "    fig.patch.set_facecolor('white')\n",
    "    \n",
    "    # Updated colors for new poverty lines\n",
    "    colors = {3.0: '#FF6B6B', 4.2: '#4ECDC4', 8.3: '#45B7D1'}\n",
    "    x = np.arange(len(key_years))\n",
    "    width = 0.25  # Narrower bars to fit three per year\n",
    "\n",
    "    # Offsets for the three poverty lines\n",
    "    offsets = {-1: 3.0, 0: 4.2, 1: 8.3}\n",
    "\n",
    "    for i, offset in offsets.items():\n",
    "        pline_data = plot_df[plot_df['povertyline'] == offset]\n",
    "        \n",
    "        if pline_data.empty:\n",
    "            continue\n",
    "            \n",
    "        fcs_data = pline_data['fcs_share'].values\n",
    "        non_fcs_data = pline_data['non_fcs_share'].values\n",
    "\n",
    "        # Plot non-FCS (bottom part)\n",
    "        ax.bar(x + (i * width), non_fcs_data, width, \n",
    "               label=f'${offset:.1f} Non-FCS', \n",
    "               color=colors[offset],\n",
    "               zorder=3)\n",
    "        \n",
    "        # Plot FCS (top part)\n",
    "        ax.bar(x + (i * width), fcs_data, width, \n",
    "               bottom=non_fcs_data, \n",
    "               label=f'${offset:.1f} FCS', \n",
    "               color=colors[offset], \n",
    "               hatch='//',\n",
    "               zorder=3)\n",
    "\n",
    "    # Add forecast bracket (covering 2030-2050)\n",
    "    forecast_start_idx = key_years.index(2030) if 2030 in key_years else None\n",
    "    forecast_end_idx = key_years.index(2050) if 2050 in key_years else None\n",
    "    \n",
    "    if forecast_start_idx is not None and forecast_end_idx is not None:\n",
    "        bracket_y = 105\n",
    "        ax.plot([forecast_start_idx - 0.6, forecast_end_idx + 0.6], [bracket_y, bracket_y], \n",
    "                color='black', linewidth=1.5)  # Top line\n",
    "        ax.plot([forecast_start_idx - 0.6, forecast_start_idx - 0.6], [102, bracket_y], \n",
    "                color='black', linewidth=1.5)  # Left vertical\n",
    "        ax.plot([forecast_end_idx + 0.6, forecast_end_idx + 0.6], [102, bracket_y], \n",
    "                color='black', linewidth=1.5)  # Right vertical\n",
    "        ax.text((forecast_start_idx + forecast_end_idx) / 2, bracket_y + 2, \"Forecast\", \n",
    "                ha='center', fontsize=12, fontweight='bold')\n",
    "\n",
    "    # Customize axes\n",
    "    ax.spines['top'].set_visible(False)\n",
    "    ax.spines['right'].set_visible(False)\n",
    "    ax.tick_params(labelsize=14)\n",
    "\n",
    "    # Add labels\n",
    "    ax.set_xlabel('Year', fontsize=16, fontweight='bold', labelpad=15)\n",
    "    ax.set_ylabel('Share of Global Poor (%)', fontsize=16, fontweight='bold', labelpad=15)\n",
    "    ax.set_title('Distribution of Global Poverty: FCS vs Non-FCS Economies', \n",
    "                 fontsize=18, fontweight='bold', pad=20)\n",
    "\n",
    "    # Set x-axis\n",
    "    ax.set_xticks(x)\n",
    "    ax.set_xticklabels(key_years)\n",
    "\n",
    "    # Add grid\n",
    "    ax.grid(axis='y', linestyle='--', alpha=0.3, zorder=0)\n",
    "    ax.set_ylim(0, 110)  # Ensures bars always add up to 100% with space for forecast bracket\n",
    "\n",
    "    # Adjust legend to have 3 columns below the plot\n",
    "    legend = ax.legend(ncol=3, loc='upper center', bbox_to_anchor=(0.5, -0.08), \n",
    "                      frameon=False, fontsize=12)\n",
    "\n",
    "    # Adjust layout\n",
    "    plt.tight_layout()\n",
    "\n",
    "    # Save or display\n",
    "    if output_path:\n",
    "        plt.savefig(output_path, dpi=300, bbox_inches='tight')\n",
    "    else:\n",
    "        plt.show()\n",
    "    \n",
    "    plt.close()\n",
    "\n",
    "# Usage\n",
    "plot_poverty_share_bars(data_dir)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "<sub><em>Source: World Bank calculation using data from the Poverty and Inequality Platform (version June 2025) and United Nations, Department of Economic and Social Affairs, Population Division (2024)</em></sub>  "
   ]
