    "def plot_poverty_trends_all(data_dir: str, output_path: str = None) -> None:\n",
    "    \"\"\"\n",
    "    Create an enhanced plot showing poverty trends for FCS and non-FCS economies \n",
    "    across all poverty lines, with historical data and forecasts up to 2050.\n",
    "    \"\"\"\n",
    "    import os\n",
    "    import pandas as pd\n",
    "    import matplotlib.pyplot as plt\n",
    "    import matplotlib.patches as patches\n",
    "    \n",
    "    # Read the data\n",
    "    data_path = os.path.join(data_dir, 'poverty_data.csv')\n",
    "    df = pd.read_csv(data_path)\n",
    "    \n",
    "    # Create FCV grouping using fcvFY25 variable\n",
    "    # Convert 'Yes'/'No' to 1/0\n",
    "    df['is_fcv'] = (df['fcvFY25'] == 'Yes').astype(int)\n",
    "    \n",
    "    # Create plot\n",
    "    plt.style.use('default')\n",
    "    fig, ax = plt.subplots(figsize=(16, 9))\n",
    "    ax.set_facecolor('#F8F9FA')\n",
    "    fig.patch.set_facecolor('white')\n",
    "    \n",
    "    # Define colors for the new poverty lines\n",
    "    colors = {\n",
    "        3.0: '#FF6B6B',    # Red for $3.00\n",
    "        4.2: '#4ECDC4',    # Teal for $4.20\n",
    "        8.3: '#45B7D1'     # Blue for $8.30\n",
    "    }\n",
    "    \n",
    "    # Add grid\n",
    "    ax.grid(True, linestyle='--', alpha=0.2, color='gray', zorder=0)\n",
    "    \n",
    "    # Process each poverty line\n",
    "    for pline in [3.0, 4.2, 8.3]:\n",
    "        df_pline = df[df['povertyline'] == pline].copy()\n",
    "        \n",
    "        if df_pline.empty:\n",
    "            continue\n",
    "        \n",
    "        # Use poorpop directly (already calculated)\n",
    "        agg_df = df_pline.groupby(['year', 'is_fcv'])['poorpop'].sum().reset_index()\n",
    "        \n",
    "        if agg_df.empty:\n",
    "            continue\n",
    "        \n",
    "        # Apply 3-year moving average within each FCV group for this poverty line\n",
    "        def apply_moving_average(group):\n",
    "            group = group.sort_values('year')\n",
    "            group['poorpop_ma3'] = group['poorpop'].rolling(window=3, center=True, min_periods=1).mean()\n",
    "            group['poorpop_ma3'] = group['poorpop_ma3'].fillna(group['poorpop'])\n",
    "            return group\n",
    "        \n",
    "        agg_df = agg_df.groupby('is_fcv', group_keys=False).apply(apply_moving_average).reset_index(drop=True)\n",
    "        agg_df['poorpop'] = agg_df['poorpop_ma3']\n",
    "        \n",
    "        # Split data into historical (up to 2025) and forecast (after 2025)\n",
    "        historical = agg_df[agg_df['year'] <= 2025]\n",
    "        forecast = agg_df[agg_df['year'] > 2025]\n",
    "        \n",
    "        # Plot historical data for non-FCS (solid lines)\n",
    "        non_fcs_hist = historical[historical['is_fcv'] == 0]\n",
    "        if not non_fcs_hist.empty:\n",
    "            ax.plot(non_fcs_hist['year'], non_fcs_hist['poorpop'], \n",
    "                    color=colors[pline], \n",
    "                    label=f'${pline:.1f} Non-FCS',\n",
    "                    linewidth=3.0,\n",
    "                    zorder=3)\n",
    "        \n",
    "        # Plot historical data for FCS (dashed lines)\n",
    "        fcs_hist = historical[historical['is_fcv'] == 1]\n",
    "        if not fcs_hist.empty:\n",
    "            ax.plot(fcs_hist['year'], fcs_hist['poorpop'], \n",
    "                    color=colors[pline],\n",
    "                    linestyle=(0, (5, 5)),\n",
    "                    label=f'${pline:.1f} FCS',\n",
    "                    linewidth=3.0,\n",
    "                    zorder=3)\n",
    "        \n",
    "        # Plot forecast data for non-FCS (dotted lines)\n",
    "        non_fcs_forecast = forecast[forecast['is_fcv'] == 0]\n",
    "        if not non_fcs_forecast.empty:\n",
    "            ax.plot(non_fcs_forecast['year'], non_fcs_forecast['poorpop'],\n",
    "                    color=colors[pline], linestyle=':', linewidth=3.0, alpha=0.8, zorder=3)\n",
    "        \n",
    "        # Plot forecast data for FCS (dotted lines)\n",
    "        fcs_forecast = forecast[forecast['is_fcv'] == 1]\n",
    "        if not fcs_forecast.empty:\n",
    "            ax.plot(fcs_forecast['year'], fcs_forecast['poorpop'],\n",
    "                    color=colors[pline], linestyle=':', linewidth=3.0, alpha=0.8, zorder=3)\n",
    "        \n",
    "        # Add data points for key years\n",
