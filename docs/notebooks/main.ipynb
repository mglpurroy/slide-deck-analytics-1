    "        \n",
    "    return plt\n",
    "\n",
    "# Main execution\n",
    "if __name__ == \"__main__\":\n",
    "    # Specify the path to the enhanced dataset\n",
    "    data_path = Path('comprehensive_displacement_data.csv')\n",
    "    \n",
    "    # Specify output path for saving\n",
    "    output_path = Path('displacement_plot.png')\n",
