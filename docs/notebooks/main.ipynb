    "    # Add labels\n",
    "    ax.set_xlabel('Year', fontsize=16, fontweight='bold', labelpad=15)\n",
    "    ax.set_ylabel('Millions of poor', fontsize=16, fontweight='bold', labelpad=15)\n",
    "    \n",
    "    # Set axis limits\n",
    "    ax.set_ylim(bottom=0)\n",
    "    ax.set_xlim(1990, 2050)\n",
    "    \n",
    "    # Add title and subtitle\n",
    "    plt.suptitle('', \n",
    "                 fontsize=20, fontweight='bold', y=0.95)\n",
    "    plt.title('Comparison across different poverty lines for FCS and non-FCS economies (3-year moving average)',\n",
    "             fontsize=16, style='italic', alpha=0.7, pad=20)\n",
    "    \n",
    "    # Create legend with larger text\n",
    "    legend = ax.legend(ncol=2, loc='upper right',\n",
    "                      frameon=True, fancybox=True, shadow=True,\n",
    "                      fontsize=14)\n",
    "    legend.get_frame().set_facecolor('white')\n",
